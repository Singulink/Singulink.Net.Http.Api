<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Deliberately a plain (non-Uno.Sdk) library that doesn't reference Uno.UI. On Skia-rendered Uno Platform heads for iOS and Android, the Uno SDK swaps
         the platform builds of referenced packages that reference Uno.UI for their plain .NET build, which strips out any platform-conditional code. This
         library is invisible to that swap, so its iOS build loads as built, and Singulink.Net.Http.Api.Client.WinUI routes its iOS behavior through it at
         run time. Its API is internal to Singulink.Net.Http.Api.Client.WinUI.

         Compatibility rule: Singulink.Net.Http.Api.Client.WinUI depends on this package's internal members, with the usual minimum-version dependency,
         so an app can get a newer version of this package than the WinUI package it references. Internal members are therefore only ever added, never
         changed or removed, so that an older WinUI package keeps working with a newer version of this one. -->
    <TargetFrameworks>net10.0;net10.0-ios</TargetFrameworks>
    <RootNamespace>Singulink.Net.Http.Api.Client</RootNamespace>

    <Description>iOS keychain and web authentication session support for Singulink.Net.Http.Api.Client.WinUI, which references it.</Description>
    <PackageTags>HTTP; API; Client; Passkeys; Session; iOS;</PackageTags>
  </PropertyGroup>

  <!-- The same minimum version as Uno Platform's. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <SupportedOSPlatformVersion>14.2</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Singulink.Net.Http.Api.Client.WinUI" PublicKey="" />
    <InternalsVisibleTo Include="Singulink.Net.Http.Api.Client.WinUI.Tests" PublicKey="" />
    <InternalsVisibleTo Include="Singulink.Net.Http.Api.Client.Native.Tests" PublicKey="" />
  </ItemGroup>
</Project>
