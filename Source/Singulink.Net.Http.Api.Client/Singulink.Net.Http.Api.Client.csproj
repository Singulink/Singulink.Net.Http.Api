<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>

    <Description>API client library for the Singulink HTTP API Toolkit.</Description>
    <PackageTags>HTTP; API; Client;</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Singulink.Net.Http.Api.Client.SignalR" PublicKey="" />
    <InternalsVisibleTo Include="Singulink.Net.Http.Api.Client.Tests" PublicKey="" />
    <InternalsVisibleTo Include="Singulink.Net.Http.Api.Client.WinUI" PublicKey="" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    <PackageReference Include="System.Net.Http.Json" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- Browser fetch options are only used on browser platforms, which always use the .NET build. -->
    <Compile Remove="Microsoft.AspNetCore.Components.WebAssembly.Http/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Singulink.Net.Http.Api\Singulink.Net.Http.Api.csproj" />
  </ItemGroup>
</Project>
