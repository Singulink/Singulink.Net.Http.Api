<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- A web app that uses the server packages, to test them in a Native AOT publish: publish it and run the published executable with its self-check
         argument (see SelfCheck.cs). Not a unit test project. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Singulink.Net.Http.Api.Service.AotTestApp</RootNamespace>

    <!-- Set here rather than on the command line: a global PublishAot property would also reach the .NET Standard build of the referenced core project,
         which fails with NETSDK1207. -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test framework packages from Tests/Directory.Build.props, which the app doesn't use. -->
    <PackageReference Remove="Shouldly" />
    <PackageReference Remove="PrefixClassName.MsTest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The self-check's hub client, which it also uses through the toolkit's client (see the project reference below). -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\Singulink.Net.Http.Api.Client.SignalR\Singulink.Net.Http.Api.Client.SignalR.csproj" />
    <ProjectReference Include="..\..\Source\Singulink.Net.Http.Api.Service.Cloudflare\Singulink.Net.Http.Api.Service.Cloudflare.csproj" />
    <ProjectReference Include="..\..\Source\Singulink.Net.Http.Api.Service.Passkeys\Singulink.Net.Http.Api.Service.Passkeys.csproj" />
    <ProjectReference Include="..\..\Source\Singulink.Net.Http.Api.Service.Testing\Singulink.Net.Http.Api.Service.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="cloudflare-ranges.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
