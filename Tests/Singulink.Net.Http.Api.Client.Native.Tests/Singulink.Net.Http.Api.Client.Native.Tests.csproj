<Project Sdk="MSTest.Sdk/4.5.1">
  <PropertyGroup>
    <RootNamespace>Singulink.Net.Http.Api.Client</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Signed with the library key so it can see the library's internals: a strong-named assembly can only name strong-named friends. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\Source\key.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!-- The tests run on the plain .NET build. The iOS build can only run on iOS. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Source\Singulink.Net.Http.Api.Client.Native\Singulink.Net.Http.Api.Client.Native.csproj" />
  </ItemGroup>
</Project>
