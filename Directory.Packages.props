<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Microsoft">
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Microsoft (Desktop)">
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Microsoft (.NET Standard 2.0)">
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="10.0.13" />
    <PackageVersion Include="System.Net.Http.Json" Version="10.0.13" />
    <PackageVersion Include="System.Text.Json" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Singulink">
    <PackageVersion Include="Singulink.Enums" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup Label="Third-Party">
    <PackageVersion Include="Fido2" Version="4.3.1" />
    <PackageVersion Include="MyCSharp.HttpUserAgentParser" Version="3.1.6" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <PackageVersion Include="DotNetAnalyzers.DocumentationAnalyzers" Version="1.0.0-beta.59" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
  </ItemGroup>

  <ItemGroup Label="Polyfills">
    <PackageVersion Include="PolySharp" Version="1.16.0" />
  </ItemGroup>

  <ItemGroup Label="Weavers">
    <PackageVersion Include="RuntimeNullables.Fody" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <PackageVersion Include="PrefixClassName.MsTest" Version="2.0.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>
</Project>
