<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>

    <Description>Shared client/service library for the Singulink HTTP API Toolkit.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Singulink.Net.Http.Api.Client" PublicKey="" />
    <InternalsVisibleTo Include="Singulink.Net.Http.Api.Client.SignalR" PublicKey="" />
    <InternalsVisibleTo Include="Singulink.Net.Http.Api.Service" PublicKey="" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>
</Project>
