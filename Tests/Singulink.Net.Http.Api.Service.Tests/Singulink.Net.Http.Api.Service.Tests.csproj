<Project Sdk="MSTest.Sdk/4.5.1">
  <PropertyGroup>
    <RootNamespace>Singulink.Net.Http.Api.Service</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Signed with the library key so that the SignalR client library's internals are visible to the tests: a strong-named assembly can only name
         strong-named friends. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\Source\key.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\Singulink.Net.Http.Api.Service\Singulink.Net.Http.Api.Service.csproj" />
    <ProjectReference Include="..\..\Source\Singulink.Net.Http.Api.Service.Testing\Singulink.Net.Http.Api.Service.Testing.csproj" />
    <ProjectReference Include="..\..\Source\Singulink.Net.Http.Api.Client.SignalR\Singulink.Net.Http.Api.Client.SignalR.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Singulink.Net.Http.Api.Client.Tests\Infrastructure\RawHttpServer.cs" Link="Infrastructure\RawHttpServer.cs" />
    <Compile Include="..\Singulink.Net.Http.Api.Client.Tests\Infrastructure\ManualTimeProvider.cs" Link="Infrastructure\ManualTimeProvider.cs" />
  </ItemGroup>
</Project>
